<%- include('../partials/head') %>
<h1>Payments</h1>
<div class="cols">
<section>
  <h2>Cash received by month</h2>
  <table><thead><tr><th>Month</th><th class="num">Payments</th><th class="num">Amount</th></tr></thead><tbody>
  <% for (const m of byMonth) { %><tr><td><%= m.month %></td><td class="num"><%= m.c %></td><td class="num"><%= money(m.m) %></td></tr><% } %>
  </tbody></table>
</section>
<section>
  <h2>Recent payments</h2>
  <table><thead><tr><th>Date</th><th>Account</th><th>Invoice</th><th>Method</th><th>Ref</th><th class="num">Amount</th></tr></thead><tbody>
  <% for (const p of payments) { %><tr><td><%= p.payment_date %></td><td><a href="/accounts/<%= p.account_id %>"><%= p.account_name %></a></td><td><% if (p.invoice_id) { %><a href="/invoices/<%= p.invoice_id %>"><%= p.invoice_number %></a><% } else { %><span class="muted">unapplied</span><% } %></td><td><%= titleCase(p.method) %></td><td><%= p.reference ?? '' %></td><td class="num"><%= money(p.amount_cents) %></td></tr><% } %>
  </tbody></table>
</section>
</div>
<%- include('../partials/foot') %>
